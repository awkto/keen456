# Commander Keen 4/5/6 native — DOSBox-X config, regenerated by the launcher on
# every start. Parity with the web bundle's .jsdos/dosbox.conf
# (machine/cycles/sound), plus native display settings. Edit
# native/appdir/dosbox-x.conf.tmpl in the repo, not this file — it is
# overwritten at each launch.

[sdl]
autolock=false
fullscreen=false
fullresolution=desktop
output=opengl
mapperfile=${DATA_DIR}/mapper-keen456.map

[render]
aspect=true
glshader=${GLSHADER}

[log]
# DOSBox-X writes this unbuffered — complete even after a crash or kill
# (a launcher-side stdout tee is block-buffered through the pipe and loses
# the tail otherwise). This is the file to ask users for when diagnosing.
logfile=${DATA_DIR}/last-run.log

[dosbox]
quit warning=false
machine=svga_s3
memsize=16
captures=${DATA_DIR}/capture
saveremark=false
# forceloadstate is deliberately left at its default (false). Setting it true
# disables all four of DOSBox-X's save-state guards (emulator version, running
# program, memory size, machine type — savestates.cpp loadstateconfirm 0..3),
# so a state that doesn't match this build is deserialized anyway instead of
# being refused. A truncated state then crashes the emulator inside the loader.
# It is also what would let a save state from the browser build through, which
# is exactly the thing that cannot work. Never re-enable it.

[cpu]
core=auto
cputype=auto
cycles=auto
cycleup=10
cycledown=20
stop turbo on key=false

[mixer]
nosound=false
rate=44100
blocksize=1024
prebuffer=20

[sblaster]
sbtype=sb16
sbbase=220
irq=7
dma=1
hdma=5
sbmixer=true
oplmode=auto
oplemu=default
oplrate=44100

[speaker]
pcspeaker=true
pcrate=44100

[dos]
xms=true
ems=true
umb=true
keyboardlayout=auto

[autoexec]
@echo off
mount c "${GAME_DIR}"
c:
${RUNCMD}
exit
