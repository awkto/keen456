+/* Keen (keen456/native): true while the physical key that drives the
+   pause toggle is still down, so GFX_Events() below can tell one press from
+   the auto-repeat storm that follows it. PauseDOSBoxLoop() clears it on the
+   way out, because the key-up that resumed us never reaches GFX_Events(). */
+bool keen_pause_key_down = false;
+
+/* Which key that is. Zeliard uses B; Keen cannot — B is a letter the player
+   needs for save-game names and for the B-A-T cheat, and this key never
+   reaches the game. KEEN_PAUSE_KEY = f11 (default) | pause | b | off. F11 is
+   free: Keen predates it and the shipped mapper leaves it unbound. */
+SDL_Scancode Keen_PauseScancode(void) {
+    static int scan = -1;
+    if (scan < 0) {
+        const char *k = getenv("KEEN_PAUSE_KEY");
+        if      (k == NULL)             scan = SDL_SCANCODE_F11;
+        else if (!strcmp(k, "pause"))   scan = SDL_SCANCODE_PAUSE;
+        else if (!strcmp(k, "b"))       scan = SDL_SCANCODE_B;
+        else if (!strcmp(k, "off"))     scan = SDL_NUM_SCANCODES; /* matches nothing */
+        else                            scan = SDL_SCANCODE_F11;
+    }
+    return (SDL_Scancode)scan;
+}
+
