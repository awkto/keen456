+    y += 16 * s;
+    zText(x, y, s, "Esc back", 0.5f, 0.5f, 0.56f);
+}
+
+static void zMenuMove(int dir) {
+    int i = z_menuSel;
+    do { i = (i + dir + ZI_COUNT) % ZI_COUNT; } while (!zItemShown(i));
+    z_menuSel = i;
+    z_quitArmed = false;
+    z_menuStatus.clear();
+}
+
+static void zMenuAdjust(int dir) {
+    switch (z_menuSel) {
+    case ZI_SLOT: {
+        int slot = ((int)GetGameState_Run() + dir + (int)SaveState::SLOT_COUNT) % (int)SaveState::SLOT_COUNT;
+        SetGameState_Run(slot);
+        break; }
+    case ZI_VOLUME: zVolumeStep(dir); z_osdKind = ZO_NONE; z_osdRepaints = 0; break;
+    case ZI_MUTE:   zToggleMute();    z_osdKind = ZO_NONE; z_osdRepaints = 0; break;
+    default: break;
+    }
+}
+
+/* Enter on the selected row. Anything that touches the emulated machine or
+   rebuilds the video output is only *requested* here: it runs from
+   Keen_OverlayPoll() once this loop has unwound, in the same place the
+   mapper would have run it. */
+static void zMenuActivate(void) {
+    const bool wasArmed = z_quitArmed;
+    z_quitArmed = false;
+    z_menuStatus.clear();
+    switch (z_menuSel) {
+    case ZI_RESUME:     z_mode = ZM_NONE; break;
+    case ZI_SAVE:       z_pending = ZP_SAVE; z_mode = ZM_NONE; break;
+    case ZI_LOAD:
+        if (SaveState::instance().isEmpty(GetGameState_Run())) z_menuStatus = "That slot is empty.";
+        else { z_pending = ZP_LOAD; z_mode = ZM_NONE; }
+        break;
+    case ZI_SLOT:       zMenuAdjust(1); break;
+    case ZI_VOLUME:     break;
+    case ZI_MUTE:       zMenuAdjust(1); break;
+    case ZI_FILTER:     z_pending = ZP_FILTER; z_mode = ZM_NONE; break;
+    case ZI_FULLSCREEN: z_pending = ZP_FULLSCREEN; z_mode = ZM_NONE; break;
+    case ZI_MAPS:       z_mode = ZM_MAP; break;
+    case ZI_HELP:       z_mode = ZM_HELP; break;
+    case ZI_BACKUP: {
+        std::vector<std::string> av;
+        av.push_back(z_launcher); av.push_back("saves"); av.push_back("backup");
+        /* --exit-code: 3 means there were no saves, so no backup was made.
+           Plain exit 0 cannot tell that from success, and "backed up" must
+           never be said about a backup that does not exist. */
+        av.push_back("--exit-code");
+        int code = -1;
+        const bool ran = zSpawn(av, true, &code);
+        if (ran && code == 0) z_menuStatus = "Saves backed up, in the backups folder.";
+        else if (ran && code == 3) z_menuStatus = "Nothing to back up yet - no in-game saves.";
+        else z_menuStatus = "Backup FAILED - try: keen456 saves backup";
+        break; }
+    case ZI_SETTINGS: {
+        std::vector<std::string> av;
+        av.push_back(z_gui);
+        z_menuStatus = zSpawn(av, false, NULL) ? "Settings window opened. Changes apply next start."
+                                               : "Could not start the settings window.";
+        break; }
+    case ZI_QUIT:
+        if (wasArmed) { z_pending = ZP_QUIT; z_mode = ZM_NONE; }
+        else z_quitArmed = true;
+        break;
+    }
+}
+
+/* -------------------------------------------------------- the modal loop */
+
+static void zModalLoop(Bitu /*unused*/) {
+    z_modalQueued = false;
+    if (z_mode == ZM_NONE) return;
+    if (!zUsingGL()) { z_mode = ZM_NONE; return; }
+
+    SDL_Event event;
+    bool quitting = false;
+    bool haveResize = false; SDL_Event lastResize;
+    bool escArmed = false, enterArmed = false;
+    bool dragging = false;
+    Uint32 lastClick = 0;
+
+    /* Same way in as PauseDOSBoxLoop(): the game must not keep any key it was
+       holding, and the mouse goes back to the desktop. */
+    MAPPER_ReleaseAllKeys();
+    GFX_ReleaseMouse();
+    GFX_SetTitle(-1, -1, -1, true);
+    GFX_LosingFocus();
+    while (SDL_PollEvent(&event)) if (event.type == SDL_QUIT) quitting = true;
+    SDL_SetRelativeMouseMode(SDL_FALSE);
+    is_paused = true;
+    z_osdKind = ZO_NONE; z_osdRepaints = 0;
+    z_menuStatus.clear(); z_quitArmed = false;
+
+    bool dirty = true;
+    Uint32 last = SDL_GetTicks();
+    while (z_mode != ZM_NONE && !quitting) {
+        int W = 0, H = 0, winW = 0, winH = 0;
+        SDL_GL_GetDrawableSize(sdl.window, &W, &H);
+        SDL_GetWindowSize(sdl.window, &winW, &winH);
+        if (W <= 0 || H <= 0) { W = sdl.surface->w; H = sdl.surface->h; }
+        const double mscale = (winW > 0) ? (double)W / winW : 1.0;
+        const int s = zUiScale(W, H);
+        const ZView view = zMapArea(W, H, s);
+        ZMap *m = (z_mode == ZM_MAP && !z_maps.empty()) ? &z_maps[z_mapIdx] : NULL;
+
+        /* Held keys glide: zoom and pan are integrated per frame, so a hold
+           lands exactly where you let go instead of stepping in jumps. */
+        const Uint8 *ks = SDL_GetKeyboardState(NULL);
+        bool animating = false;
+        const Uint32 now = SDL_GetTicks();
+        double dt = (now - last) / 1000.0; last = now;
+        if (dt > 0.05) dt = 0.05;
+        if (m != NULL && z_mapTexIdx == z_mapIdx) {
+            const bool zin  = ks[SDL_SCANCODE_EQUALS] || ks[SDL_SCANCODE_KP_PLUS];
+            const bool zout = ks[SDL_SCANCODE_MINUS]  || ks[SDL_SCANCODE_KP_MINUS];
+            if (zin != zout) {
+                zZoomAt(*m, view, pow(1.9, zin ? dt : -dt), view.x + view.w / 2, view.y + view.h / 2);
+                animating = dirty = true;
+            }
+            const double sc = zFitScale(view) * m->zoom;
+            const double rate = 0.9 * view.w * dt;               /* px this frame */
+            const int dx = (ks[SDL_SCANCODE_RIGHT] ? 1 : 0) - (ks[SDL_SCANCODE_LEFT] ? 1 : 0);
+            const int dy = (ks[SDL_SCANCODE_DOWN] ? 1 : 0) - (ks[SDL_SCANCODE_UP] ? 1 : 0);
+            if ((dx || dy) && m->zoom > 1.001 && sc > 0) {
+                m->cx += dx * rate / (z_mapW * sc);
+                m->cy += dy * rate / (z_mapH * sc);
+                zClampView(*m, view);
+                animating = dirty = true;
+            }
+        }
+
+        if (dirty) {
+            if (z_mode == ZM_MAP) zDrawMap(W, H);
+            else if (z_mode == ZM_MENU) zDrawMenu(W, H);
+            else zDrawHelp(W, H);
+            SDL_GL_SwapBuffers();
+            dirty = false;
+        }
+
+        bool got;
+        if (animating) { got = SDL_PollEvent(&event) != 0; if (!got) SDL_Delay(4); }
+        else { got = SDL_WaitEventTimeout(&event, 500) != 0; last = SDL_GetTicks(); }
+
+        for (; got; got = SDL_PollEvent(&event) != 0) {
+            switch (event.type) {
+            case SDL_QUIT: quitting = true; break;
+            case SDL_WINDOWEVENT:
+                if (event.window.event == SDL_WINDOWEVENT_RESIZED || event.window.event == SDL_WINDOWEVENT_SIZE_CHANGED) {
+                    lastResize = event; haveResize = true;
+                }
+                dirty = true;
+                break;
+            case SDL_KEYDOWN: {
+                const SDL_Scancode sc = event.key.keysym.scancode;
+                const bool rep = event.key.repeat != 0;
+                const bool ctrl = (event.key.keysym.mod & KMOD_CTRL) != 0;
+                dirty = true;
+                if (sc == SDL_SCANCODE_ESCAPE) { if (!rep) escArmed = true; break; }
+                if (sc == SDL_SCANCODE_RETURN || sc == SDL_SCANCODE_KP_ENTER) { if (!rep) enterArmed = true; break; }
+                if (sc == SDL_SCANCODE_M && !rep) {
+                    if (ctrl) { zOpenMapsExternally(); break; }
+                    z_mode = (z_mode == ZM_MAP || z_maps.empty()) ? ZM_NONE : ZM_MAP;
+                    break;
+                }
+                if (sc == z_menuKey && !rep) { z_mode = (z_mode == ZM_MENU) ? ZM_NONE : ZM_MENU; break; }
+                if (z_mode == ZM_MAP && m != NULL) {
+                    const bool atFit = m->zoom <= 1.001;
+                    int step = 0;
+                    if (!rep && (sc == SDL_SCANCODE_RIGHTBRACKET || sc == SDL_SCANCODE_PAGEDOWN)) step = 1;
+                    if (!rep && (sc == SDL_SCANCODE_LEFTBRACKET || sc == SDL_SCANCODE_PAGEUP)) step = -1;
+                    /* With the whole map in view there is nothing to pan, so
+                       the arrows turn the page instead. */
+                    if (!rep && atFit && sc == SDL_SCANCODE_RIGHT) step = 1;
+                    if (!rep && atFit && sc == SDL_SCANCODE_LEFT) step = -1;
+                    if (step) z_mapIdx = (z_mapIdx + step + (int)z_maps.size()) % (int)z_maps.size();
+                    if (!rep && (sc == SDL_SCANCODE_0 || sc == SDL_SCANCODE_KP_0 || sc == SDL_SCANCODE_HOME)) {
+                        m->zoom = 1.0; m->cx = m->cy = 0.5;
+                    }
+                } else if (z_mode == ZM_MENU) {
+                    if (sc == SDL_SCANCODE_UP) zMenuMove(-1);
+                    else if (sc == SDL_SCANCODE_DOWN) zMenuMove(1);
+                    else if (sc == SDL_SCANCODE_LEFT) zMenuAdjust(-1);
+                    else if (sc == SDL_SCANCODE_RIGHT) zMenuAdjust(1);
+                }
+                break; }
+            case SDL_KEYUP: {
+                const SDL_Scancode sc = event.key.keysym.scancode;
+                if (sc == SDL_SCANCODE_ESCAPE && escArmed) {
+                    escArmed = false; dirty = true;
+                    z_mode = (z_mode == ZM_HELP) ? ZM_MENU : ZM_NONE;
+                } else if ((sc == SDL_SCANCODE_RETURN || sc == SDL_SCANCODE_KP_ENTER) && enterArmed) {
+                    enterArmed = false; dirty = true;
+                    if (z_mode == ZM_MENU) zMenuActivate();
+                    else if (z_mode == ZM_HELP) z_mode = ZM_MENU;
+                }
+                break; }
+            case SDL_MOUSEBUTTONDOWN:
+                if (z_mode == ZM_MAP && event.button.button == SDL_BUTTON_LEFT) {
+                    const Uint32 t = SDL_GetTicks();
+                    if (m != NULL && t - lastClick < 350) { m->zoom = 1.0; m->cx = m->cy = 0.5; dirty = true; }
+                    lastClick = t;
+                    dragging = true;
+                }
+                break;
+            case SDL_MOUSEBUTTONUP:
+                if (event.button.button == SDL_BUTTON_LEFT) dragging = false;
+                break;
+            case SDL_MOUSEMOTION:
+                if (dragging && m != NULL && z_mapTexIdx == z_mapIdx) {
+                    const double sc = zFitScale(view) * m->zoom;
+                    if (sc > 0) {
+                        m->cx -= event.motion.xrel * mscale / (z_mapW * sc);
+                        m->cy -= event.motion.yrel * mscale / (z_mapH * sc);
+                        zClampView(*m, view);
+                        dirty = true;
+                    }
+                }
+                break;
+            case SDL_MOUSEWHEEL:
+                if (m != NULL && z_mapTexIdx == z_mapIdx && event.wheel.y != 0) {
+                    int mx = 0, my = 0;
+                    SDL_GetMouseState(&mx, &my);
+                    zZoomAt(*m, view, event.wheel.y > 0 ? 1.15 : 1 / 1.15, mx * mscale, my * mscale);
+                    dirty = true;
+                }
+                break;
+            default: break;
+            }
+        }
+    }
+
+    zSaveState();
+
+    /* And the same way out as PauseDOSBoxLoop(). */
+    GFX_UpdateSDLCaptureState();
+    MAPPER_ReleaseAllKeys();
+    while (SDL_PollEvent(&event)) {
+        if (event.type == SDL_QUIT) quitting = true;
+        else if (event.type == SDL_WINDOWEVENT &&
+                 (event.window.event == SDL_WINDOWEVENT_RESIZED || event.window.event == SDL_WINDOWEVENT_SIZE_CHANGED)) {
+            lastResize = event; haveResize = true;
+        }
+    }
+    /* The window may have been resized under us; GFX_Events() never saw it,
+       so hand it the last word on the size now. */
+    if (haveResize) SDL_PushEvent(&lastResize);
+    if (quitting) { SDL_Event q; memset(&q, 0, sizeof(q)); q.type = SDL_QUIT; SDL_PushEvent(&q); }
+    memset(z_swallowed, 0, sizeof(z_swallowed));
+    z_mode = ZM_NONE;
+
+    GFX_LosingFocus();
+    GFX_SetTitle(-1, -1, -1, false);
+    if (sdl.draw.callback) (sdl.draw.callback)(GFX_CallBackReset);
+    is_paused = false;
+}
+
+#else /* !C_OPENGL */
+
+void Keen_OverlayGLReset(void) {}
+bool Keen_OverlayWantsRepaint(void) { return false; }
+void Keen_OverlayDrawOSD(void) {}
+static bool zUsingGL(void) { return false; }
+static void zRepaintIdle(void) {}
+static void zModalLoop(Bitu) { z_modalQueued = false; z_mode = ZM_NONE; }
