+/* Keen overlay (keen456/native): the volume OSD, the reference-map
+   viewer and the in-game menu.
+
+   Why this is in the emulator and not the launcher: all three have to draw on
+   the game's own window, and two of them have to stop the emulation while
+   they are up. The launcher is a separate process that has exec'd away (or is
+   only waiting) by the time the game runs.
+
+   How it draws: only output=opengl is supported. DOSBox-X's OpenGL output is
+   a compatibility-profile context that already uses display lists and
+   immediate mode, so the overlay does the same — plain textured quads with the
+   fixed-function pipeline, the shader program unbound for the duration. With
+   any other output the volume keys still work (without the OSD), M falls back
+   to opening the maps in a browser, and the menu is unavailable.
+
+   How it gets keys: GFX_Events() offers every key event to
+   Keen_OverlayKeyEvent() before the mapper. Like the B pause toggle, none
+   of these may be mapper bindings: the modal screens below are a second event
+   loop, exactly like PauseDOSBoxLoop(), and MAPPER_ReleaseAllKeys() on the way
+   in and out clears the latch that stops SDL's auto-repeat re-firing a bind.
+   For the same reason the modal screens act on the *release* of Esc and Enter
+   — a release cannot repeat, so a key held a moment too long is not replayed
+   into the game as a fresh press the instant emulation resumes.
+
+   The launcher turns all this on with KEEN_OVERLAY=1 and says where things
+   are: KEEN_MAPS (a tab-separated index: path, name, world),
+   KEEN_MAPS_URL (what Ctrl+M opens), KEEN_OVERLAY_STATE (where volume
+   and the map view are remembered), KEEN_MENU_KEY, KEEN_LAUNCHER and
+   KEEN_GUI. Without KEEN_OVERLAY this file does nothing at all. */
+
+#include "config.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <string>
+#include <vector>
+
+#include "dosbox.h"
+#include "logging.h"
+#include "video.h"
+#include "mixer.h"
+#include "mapper.h"
+#include "pic.h"
+#include "control.h"
+#include "setup.h"
+#include "sdlmain.h"
+#include "../ints/int10.h"
+#include "keen_overlay.h"
