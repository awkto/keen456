+/* Keen overlay (keen456/native): volume OSD, reference-map viewer and
+   the in-game menu. Everything lives in src/gui/keen_overlay.cpp; these are
+   the few places the rest of the emulator has to call into it. */
+#ifndef KEEN_OVERLAY_H
+#define KEEN_OVERLAY_H
+
+union SDL_Event;
+
+/* GFX_Events(): offered every key event before the mapper sees it. True means
+   the overlay owns the key and the game must not get it. */
+bool Keen_OverlayKeyEvent(const SDL_Event &event);
+
+/* GFX_Events(): once per call. Applies the saved volume on the first pass,
+   expires the OSD and repaints a screen the game is not currently redrawing. */
+void Keen_OverlayPoll(void);
+
+/* A line of OSD text, shown the same way the volume bar is. */
+void Keen_OverlayToast(const char *text);
+
+/* OUTPUT_OPENGL_EndUpdate(): the OSD wants this frame presented even though
+   the game changed nothing in it. */
+bool Keen_OverlayWantsRepaint(void);
+
+/* OUTPUT_OPENGL_EndUpdate(): draw the OSD over the finished frame, just
+   before the buffer swap. */
+void Keen_OverlayDrawOSD(void);
+
+/* OUTPUT_OPENGL_SetSize(): the GL context or its textures were rebuilt, so
+   every texture id the overlay holds is stale. */
+void Keen_OverlayGLReset(void);
+
+/* sdlmain.cpp, next to the V filter cycle it wraps. */
+const char *Keen_FilterCycleStep(void);
+
+#endif
