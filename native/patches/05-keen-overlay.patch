+#endif /* C_OPENGL */
+
+static void zOpenModal(ZMode mode) {
+    if (z_modalQueued || is_paused) return;
+#if C_OPENGL
+    /* Always open on the harmless row, so the menu key followed by Enter is
+       never anything worse than a resume. */
+    z_menuSel = ZI_RESUME;
+#endif
+    z_mode = mode;
+    z_modalQueued = true;
+    PIC_AddEvent(zModalLoop, 0.001);
+}
+
+/* ------------------------------------------------------------ entry points */
+
+static void zInit(void) {
+    z_inited = true;
+    const char *e = getenv("KEEN_OVERLAY");
+    z_enabled = (e != NULL && *e == '1');
+    if (!z_enabled) return;
+    memset(z_swallowed, 0, sizeof(z_swallowed));
+    if ((e = getenv("KEEN_OVERLAY_STATE")) != NULL) z_statePath = e;
+    if ((e = getenv("KEEN_MAPS_URL")) != NULL) z_mapsUrl = e;
+    if ((e = getenv("KEEN_LAUNCHER")) != NULL) z_launcher = e;
+    if ((e = getenv("KEEN_GUI")) != NULL) z_gui = e;
+    if ((e = getenv("KEEN_MAPS")) != NULL) zLoadMapIndex(e);
+    if ((e = getenv("KEEN_MENU_KEY")) != NULL) {
+        if (!strcmp(e, "grave")) z_menuKey = SDL_SCANCODE_GRAVE;
+        else if (!strcmp(e, "f1")) z_menuKey = SDL_SCANCODE_F1;
+        else if (!strcmp(e, "f10")) z_menuKey = SDL_SCANCODE_F10;
+        else if (!strcmp(e, "off")) z_menuKey = SDL_SCANCODE_UNKNOWN;
+    }
+    zLoadState();
+    zApplyVolume();
+    LOG_MSG("Keen: overlay on - volume %d%s, %d maps", z_volume, z_muted ? " (muted)" : "", (int)z_maps.size());
+}
+
+void Keen_OverlayPoll(void) {
+    if (!z_inited) zInit();
+    if (!z_enabled) return;
+
+    if (z_pending != ZP_NONE && !z_modalQueued && z_mode == ZM_NONE) {
+        const ZPending p = z_pending;
+        z_pending = ZP_NONE;
+        char buf[48];
+        switch (p) {
+        case ZP_SAVE:
+            SaveGameState_Run();
+            snprintf(buf, sizeof(buf), "STATE %d SAVED", (int)GetGameState_Run() + 1);
+            Keen_OverlayToast(buf);
+            break;
+        case ZP_LOAD:
+            LoadGameState_Run();
+            snprintf(buf, sizeof(buf), "STATE %d LOADED", (int)GetGameState_Run() + 1);
+            Keen_OverlayToast(buf);
+            break;
+        case ZP_FILTER:     Keen_FilterCycleStep(); break;
+        case ZP_FULLSCREEN: GFX_SwitchFullScreen(); break;
+        case ZP_QUIT: { SDL_Event q; memset(&q, 0, sizeof(q)); q.type = SDL_QUIT; SDL_PushEvent(&q); break; }
+        default: break;
+        }
+    }
+
+    if (z_osdKind != ZO_NONE && (Sint32)(SDL_GetTicks() - z_osdUntil) >= 0) {
+        z_osdKind = ZO_NONE;
+        z_osdRepaints = 2;
+        if (z_stateDirty) zSaveState();
+    }
+    if (z_osdRepaints > 0) zRepaintIdle();
+}
+
+bool Keen_OverlayKeyEvent(const SDL_Event &event) {
+    if (!z_inited) zInit();
+    if (!z_enabled) return false;
+    const SDL_Scancode sc = event.key.keysym.scancode;
+    if ((int)sc < 0 || sc >= SDL_NUM_SCANCODES) return false;
+
+    if (event.type == SDL_KEYUP) {
+        if (!z_swallowed[sc]) return false;
+        z_swallowed[sc] = false;
+        return true;
+    }
+
+    const Uint16 mod = event.key.keysym.mod;
+    const bool rep = event.key.repeat != 0;
+    if (mod & (KMOD_ALT | KMOD_GUI)) return false;
+    const bool ctrl = (mod & KMOD_CTRL) != 0, shift = (mod & KMOD_SHIFT) != 0;
+
+    bool mine = false;
+    if (!ctrl && (sc == SDL_SCANCODE_EQUALS || sc == SDL_SCANCODE_KP_PLUS)) { zVolumeStep(1); mine = true; }
+    else if (!ctrl && (sc == SDL_SCANCODE_MINUS || sc == SDL_SCANCODE_KP_MINUS)) { zVolumeStep(-1); mine = true; }
+    else if (!ctrl && (sc == SDL_SCANCODE_KP_MULTIPLY || (sc == SDL_SCANCODE_8 && shift))) {
+        if (!rep) zToggleMute();
+        mine = true;
+    } else if (sc == SDL_SCANCODE_M && (!z_maps.empty() || !z_mapsUrl.empty())) {
+        /* Keen ships no reference maps, so the launcher sets neither variable
+           and M stays the game's: it is a letter the player needs for
+           save-game names. The viewer is kept for parity with zeliard. */
+        if (!rep) {
+            if (ctrl || !zUsingGL() || z_maps.empty()) {
+                /* In a browser instead — and pause, because the game is about
+                   to be behind another window with nobody at the controls. */
+                if (zOpenMapsExternally()) PauseDOSBox(true);
+            } else zOpenModal(ZM_MAP);
+        }
+        mine = true;
+    } else if (!ctrl && sc == z_menuKey && z_menuKey != SDL_SCANCODE_UNKNOWN && zUsingGL()) {
+        if (!rep) zOpenModal(ZM_MENU);
+        mine = true;
+    }
+    if (mine) z_swallowed[sc] = true;
+    return mine;
+}
