+/* Keen turbo (keen456/native): hold a key to fast-forward. Ported from
+   zeliard-wasm/native.
+
+   Polled here rather than bound as a mapper event on purpose. The mapper
+   delivers discrete key-down/key-up events, and a turbo bound that way is
+   unreliable in practice — it can engage seconds late or miss a press
+   entirely. Reading the keyboard state every pass cannot miss a hold or be
+   confused by auto-repeat, which is what the pogo poll above already relies on.
+
+   KEEN_FF_KEY names the key (shift/tab/f, "off" disables; unset = shift).
+   Shift is the default: Keen does not use it, and unlike ctrl (Jump, and mod1
+   for the Ctrl+. / Ctrl+\ quick-save) or alt (Pogo) nothing else wants it.
+   Needs [cpu] stop turbo on key=false, or any other key cancels it. */
+#if defined(C_SDL2)
+static void Keen_TurboPoll(void) {
+    extern void Keen_UnlockSpeed(bool pressed);
+    static int ffScan = -1;
+    if (ffScan < 0) {
+        const char *k = getenv("KEEN_FF_KEY");
+        if      (k == NULL)           ffScan = SDL_SCANCODE_LSHIFT;
+        else if (!strcmp(k, "tab"))   ffScan = SDL_SCANCODE_TAB;
+        else if (!strcmp(k, "f"))     ffScan = SDL_SCANCODE_F;
+        else if (!strcmp(k, "off"))   ffScan = 0;
+        else                          ffScan = SDL_SCANCODE_LSHIFT;
+    }
+    if (ffScan == 0) return;
+    const Uint8 *ks = SDL_GetKeyboardState(NULL);
+    static bool ffHeld = false;
+    bool ff = ks[ffScan] != 0;
+    /* Either side's shift, so the binding does not depend on which one the
+       player reaches for. */
+    if (ffScan == SDL_SCANCODE_LSHIFT) ff = ff || ks[SDL_SCANCODE_RSHIFT] != 0;
+    if (ff != ffHeld) { ffHeld = ff; Keen_UnlockSpeed(ff); }
+}
+#endif
