+/* Keen turbo (keen456/native): hold-style fast-forward. DOSBOX_UnlockSpeed
+   above is the hold-semantics speedlock handler but it is static; export a
+   thin wrapper so the key-state poll in sdlmain.cpp can drive it from a plain
+   held key. Ported from zeliard-wasm/native.
+
+   Unlocking the tick limiter alone leaves fast-forward RENDER-bound: every
+   emulated frame is still drawn at full cost. Two knobs fix that, both scoped
+   to the hold and restored on release:
+
+   KEEN_FF_FRAMESKIP (0..10, unset = 6) renders 1 frame in every N+1 while
+   held. At Keen's low real-mode cycle count this is the one that matters.
+
+   KEEN_FF_CYCLES_PCT (1..100, unset = 100 = off) additionally drops
+   CPU_CycleMax to that percentage for the hold, making each emulated
+   millisecond cheaper. Fixed-cycles only — under cycles=auto
+   DOSBOX_UnlockSpeed already does its own /3. */
+void Keen_UnlockSpeed( bool pressed ) {
+    static cpu_cycles_count_t savedCycles = 0;
+    static Bitu savedSkip = 0;
+    static bool skipSaved = false;
+    static int pct = -1, skip = -1;
+    if (pct < 0) {
+        const char *e = getenv("KEEN_FF_CYCLES_PCT");
+        pct = (e != NULL) ? atoi(e) : 100;
+        if (pct < 1 || pct > 100) pct = 100;
+        const char *f = getenv("KEEN_FF_FRAMESKIP");
+        skip = (f != NULL) ? atoi(f) : 6;
+        if (skip < 0 || skip > 10) skip = 6;
+    }
+    if (skip > 0) {
+        if (pressed && !skipSaved) {
+            savedSkip = render.frameskip.max;
+            skipSaved = true;
+            render.frameskip.max = (Bitu)skip;
+        } else if (!pressed && skipSaved) {
+            render.frameskip.max = savedSkip;
+            skipSaved = false;
+        }
+    }
+    if (pct < 100 && !CPU_CycleAutoAdjust) {
+        if (pressed && savedCycles == 0) {
+            savedCycles = CPU_CycleMax;
+            CPU_CycleMax = CPU_CycleMax * pct / 100;
+            if (CPU_CycleMax < 1000) CPU_CycleMax = 1000;
+            LOG_MSG("Keen FF: cycles %d -> %d for the hold",
+                    (int)savedCycles, (int)CPU_CycleMax);
+        } else if (!pressed && savedCycles != 0) {
+            CPU_CycleMax = savedCycles;
+            savedCycles = 0;
+        }
+    }
+    LOG_MSG("Keen FF: %s", pressed ? "on" : "off");
+    DOSBOX_UnlockSpeed(pressed);
+}
