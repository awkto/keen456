                 putenv("SDL_VIDEODRIVER=x11"); // default to x11 (xwayland) on Linux
+#elif defined(__ANDROID__)
+                /* let SDL auto-pick its "android" video driver; forcing x11 here
+                   makes SDL_Init fail with "x11 not available" */
 #elif defined(WIN32)
                 /* hack: Encourage SDL to use windib if not otherwise specified */
 #if defined(C_SDL2)
@@ -9567,6 +9624,36 @@ int main(int argc, char* argv[]) SDL_MAIN_NOEXCEPT {
         }
 #endif
 
+#if defined(__ANDROID__)
+        /* Load the launcher-written config from app-external storage. The workdir
+           logic above calls control->ClearExtraData(), which wipes every section's
+           data (including [autoexec]); parse our conf here, right before
+           GUI_StartUp, so the launcher's "mount c ... / run game" autoexec
+           actually executes instead of dropping to a bare Z:\> prompt. */
+        {
+            /* External storage first (user-reachable, so saves/logs can be pulled
+               off the device), then internal — getExternalFilesDir() returns null
+               when external storage is unmounted, and the app falls back to
+               filesDir in that case, so look in both. */
+            const char *paths[2] = { SDL_AndroidGetExternalStoragePath(),
+                                     SDL_AndroidGetInternalStoragePath() };
+            bool loaded = false;
+            for (int i = 0; i < 2 && !loaded; i++) {
+                if (paths[i] == NULL) continue;
+                std::string androidconf = std::string(paths[i]) + "/dosbox-x.conf";
+                struct stat ast;
+                if (stat(androidconf.c_str(), &ast) == 0 && S_ISREG(ast.st_mode)) {
+                    LOG_MSG("ANDROID: loading launcher config %s", androidconf.c_str());
+                    control->ParseConfigFile(androidconf.c_str());
+                    loaded = true;
+                }
+            }
+            if (!loaded)
+                LOG_MSG("ANDROID: no launcher config found (external=%s internal=%s)",
+                        paths[0] ? paths[0] : "(null)", paths[1] ? paths[1] : "(null)");
+        }
+#endif
+
         /* GUI init */
         GUI_StartUp();
 
