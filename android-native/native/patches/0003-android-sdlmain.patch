+        }
+    }
+#endif
     if (sdl.renderer) {
         SDL_DestroyRenderer(sdl.renderer);
         sdl.renderer = nullptr;
@@ -8641,6 +8687,14 @@ int main(int argc, char* argv[]) SDL_MAIN_NOEXCEPT {
     int workdirsave = 0;
