@@ -1116,6 +1116,34 @@ bool IsDebuggerActive(void);
 
 extern std::string dosbox_title;
 
+#if defined(__ANDROID__)
+#include <jni.h>
+/* DOSBox-X's status line (incl. "FPS nn, nn%/RT" when showdetails=true) would go
+   in the window title; on Android there is no title bar, so cache it here for the
+   Java side to read as a debug/FPS readout. */
+char android_status_line[256] = {0};
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_awkto_keen456_Native_nativeStatusLine(JNIEnv *env, jclass clazz) {
+    (void)clazz;
+    return env->NewStringUTF(android_status_line);
+}
+/* Keen: set a process environment variable from Kotlin before the emulator
+   thread reads it. This is how the launcher hands the in-emulator features their
+   settings (KEEN_POGO / KEEN_POGO_HOLD, consumed by Keen_DesktopPogoPoll)
+   without a config-file round trip — on desktop the Go launcher exports these
+   into the child process, which Android has no equivalent of. Must be called
+   before SDL_main starts (i.e. from Activity.onCreate, after loadLibraries). */
+extern "C" JNIEXPORT void JNICALL
+Java_com_awkto_keen456_Native_nativeSetEnv(JNIEnv *env, jclass clazz, jstring jk, jstring jv) {
+    (void)clazz;
+    const char *k = env->GetStringUTFChars(jk, NULL);
+    const char *v = env->GetStringUTFChars(jv, NULL);
+    if (k != NULL && v != NULL) setenv(k, v, 1);
+    if (k != NULL) env->ReleaseStringUTFChars(jk, k);
+    if (v != NULL) env->ReleaseStringUTFChars(jv, v);
+}
+#endif
+
 void GFX_SetTitle(int32_t cycles, int frameskip, Bits timing, bool paused) {
     (void)frameskip;//UNUSED
     (void)timing;//UNUSED
@@ -1186,6 +1214,11 @@ void GFX_SetTitle(int32_t cycles, int frameskip, Bits timing, bool paused) {
 #if C_DEBUG
     if (IsDebuggerActive()) strcat(title," DEBUGGER");
 #endif
+#if defined(__ANDROID__)
+    /* expose the finished status line to the Java FPS overlay */
+    strncpy(android_status_line, title, sizeof(android_status_line)-1);
+    android_status_line[sizeof(android_status_line)-1] = 0;
+#endif
 #if defined(C_SDL2)
     SDL_SetWindowTitle(sdl.window,title);
 #else
@@ -1791,6 +1824,19 @@ SDL_Window* GFX_GetSDLWindow(void) {
 SDL_Window* GFX_SetSDLWindowMode(uint16_t width, uint16_t height, SCREEN_TYPES screenType)
 {
     static SCREEN_TYPES lastType = SCREEN_SURFACE;
+#if defined(__ANDROID__)
+    /* The Android SDL window is always the full display; keep the window/renderer
