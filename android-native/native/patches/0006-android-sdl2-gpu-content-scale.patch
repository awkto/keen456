-        if (SDL_RenderCopy(data->renderer, data->texture, NULL, NULL) < 0) {
-            return -1;
+        if (dbx_content_w > 0 && dbx_content_h > 0) {
+            /* GPU aspect-fit the content texture into the real render output */
+            int ow = 0, oh = 0;
+            SDL_Rect dst;
+            SDL_Rect srcrect;
+            SDL_Rect *srcp = NULL;
+            SDL_GetRendererOutputSize(data->renderer, &ow, &oh);
+            if (ow > 0 && oh > 0 && w > 0 && h > 0) {
+                /* display aspect if DOSBox-X supplied one, else pixel aspect */
+                float sar = (dbx_content_aspect > 0.0)
+                                ? (float)dbx_content_aspect
+                                : (float)w / (float)h;
+                float oar = (float)ow / (float)oh;     /* output aspect */
+                if (dbx_zoom_pane > 1.0) {
+                    /* Fixed pane: the picture area is pane/sar of the width in
+                       BOTH zoom states, so the touch controls under it never
+                       move when zoom toggles. Content is centred in the pane —
+                       un-zoomed that letterboxes the 4:3 frame between black
+                       bars; zoomed the crop fills the pane exactly. */
+                    double p = dbx_zoom_pane;
+                    int paneH;
+                    if (dbx_zoom_scale > 1.0) {
+                        double s = dbx_zoom_scale;
+                        if (p > s) p = s;              /* can't show more than exists */
+                        srcrect.w = (int)((double)w / s + 0.5);
+                        srcrect.h = (int)((double)h * p / s + 0.5);
+                        if (srcrect.w < 1) srcrect.w = 1;
+                        if (srcrect.h < 1) srcrect.h = 1;
+                        if (srcrect.w > w) srcrect.w = w;
+                        if (srcrect.h > h) srcrect.h = h;
+                        srcrect.x = (w - srcrect.w) / 2;
+                        /* origin_y picks where the vertical crop comes from:
+                           1.0 = all off the top, HUD at the bottom never cut. */
+                        srcrect.y = (int)((double)(h - srcrect.h) * dbx_zoom_origin_y + 0.5);
+                        if (srcrect.y < 0) srcrect.y = 0;
+                        if (srcrect.y > h - srcrect.h) srcrect.y = h - srcrect.h;
+                        srcp = &srcrect;
+                        dst.w = ow;
+                        dst.h = (int)((double)ow * p / (double)sar + 0.5);
+                    } else {
+                        dst.w = ow;
