+/* === DOSBox-X Android: content-sized framebuffer + GPU aspect-fit scaling ===
+   The DOS framebuffer is small (e.g. 720x400); the Android window is the full
+   display size. We size the window-texture to the DOS *content*, then aspect-fit
+   that texture onto the full render output on the GPU at present time — no
+   per-frame CPU upscale. SDL builds with -fvisibility=hidden, so the entry
+   points DOSBox-X calls must be explicitly exported. */
+#define DBX_EXPORT __attribute__((visibility("default")))
+static int dbx_content_w = 0, dbx_content_h = 0;
+DBX_EXPORT void SDL_DBX_SetContentSize(int w, int h)
+{
+    dbx_content_w = w;
+    dbx_content_h = h;
+}
+/* Intended *display* aspect of the content, which is not the same as its pixel
+   dimensions: the game's frames are a double-scanned 320x200 mode meant to
+   fill a 4:3 screen, so fitting by 640/400 = 1.6 stretches the picture sideways.
+   DOSBox-X knows the right number (sdl.srcAspect.xToY); output_surface hands it
+   over here so the GPU fit uses it instead of the raw pixel ratio. 0 = fall back
+   to pixel dimensions. */
+static double dbx_content_aspect = 0.0;
+DBX_EXPORT void SDL_DBX_SetContentAspect(double aspect)
+{
+    dbx_content_aspect = (aspect > 0.0) ? aspect : 0.0;
+}
+/* Zoom/crop — the web app's Z button, done as a source rectangle on the same
+   GPU blit (no extra cost). Crops the picture's border so the playfield
+   fills more of a phone screen.
+
+   The picture pane has ONE fixed height in both zoom states — zoom_pane times
+   the width-fit height (96/75 on the web) — so the touch controls beneath it
+   never shift when zoom toggles. Un-zoomed (scale <= 1), the full frame sits
+   centred in that pane with letterbox bars; zoomed, the crop fills the pane
+   exactly. zoom_origin_y picks where the vertical crop comes from (1.0 = all
+   off the top, so the HUD at the bottom is never cut — the web app pins the
+   scaled canvas's bottom edge the same way). pane <= 1 disables the pane and
+   falls back to the plain top-aligned aspect fit.
+
+   The values are read on the render thread at present time but are only ever
+   set from the UI thread; a torn read at worst mis-frames a single present,
+   so they are deliberately unsynchronized. */
+static double dbx_zoom_scale = 0.0, dbx_zoom_pane = 0.0, dbx_zoom_origin_y = 0.0;
+DBX_EXPORT void SDL_DBX_SetContentZoom(double scale, double pane, double originY)
+{
+    dbx_zoom_scale = scale;
+    dbx_zoom_pane = pane;
+    dbx_zoom_origin_y = originY;
+}
+/* Smooth/Crisp pixels (Settings ▸ Pixels): 1 = linear, 0 = nearest, -1 = no
+   preference expressed yet. This SDL's GLES2 renderer sets the GL filter only
+   in CreateTexture (there is no SetTextureScaleMode), so a live change has to
+   recreate the window texture — SDL_UpdateWindowTexture does that when the
+   wanted mode differs from the applied one and refills it from the persistent
+   pixel buffer, so the swap never shows. Same (un)synchronization story as the
+   zoom values above. */
+static int dbx_scale_linear = -1, dbx_scale_applied = -1;
+DBX_EXPORT void SDL_DBX_SetScaleLinear(int linear)
+{
+    dbx_scale_linear = linear;
+}
+#ifdef __ANDROID__
+/* Kotlin toggles zoom / pixel filtering at runtime through these. JNI resolves
+   native methods across every loaded library, so com.awkto.keen456.Native's
+   methods may live here in libSDL2.so even though the rest of the bridge is in
+   libmain.so. */
+#include <jni.h>
+JNIEXPORT void JNICALL Java_com_awkto_keen456_Native_nativeSetZoom(JNIEnv *env, jclass clazz, jdouble scale, jdouble pane, jdouble originY)
+{
+    (void)env; (void)clazz;
+    SDL_DBX_SetContentZoom(scale, pane, originY);
+}
+JNIEXPORT void JNICALL Java_com_awkto_keen456_Native_nativeSetScaleLinear(JNIEnv *env, jclass clazz, jint linear)
+{
+    (void)env; (void)clazz;
+    SDL_DBX_SetScaleLinear((int)linear);
+}
+#endif
+static void DBX_GetFbSize(SDL_Window *window, int *w, int *h)
+{
+    if (dbx_content_w > 0 && dbx_content_h > 0) {
+        *w = dbx_content_w;
+        *h = dbx_content_h;
+        return;
+    }
+    SDL_GetWindowSizeInPixels(window, w, h);
+}
+DBX_EXPORT void SDL_DBX_InvalidateWindowSurface(SDL_Window *window)
+{
+    /* Drop the stale (window-sized) framebuffer so the next SDL_GetWindowSurface
+       rebuilds it at the current content size. */
+    if (window) {
+        window->surface_valid = SDL_FALSE;
+    }
+}
