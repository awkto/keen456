+                       at the top of the screen and the on-screen controls own the
+                       space underneath it. Centring would split the leftover
+                       height into two useless bands, above and below. */
+                    dst.y = 0;
+                }
+            } else {
+                dst.x = 0; dst.y = 0; dst.w = w; dst.h = h;
+            }
+            SDL_SetRenderDrawColor(data->renderer, 0, 0, 0, 255);
+            SDL_RenderClear(data->renderer);
