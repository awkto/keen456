+                    paneH = (int)((double)ow * dbx_zoom_pane / (double)sar + 0.5);
+                    if (paneH > oh) paneH = oh;
+                    if (dst.h > paneH) dst.h = paneH;
+                    dst.x = (ow - dst.w) / 2;
+                    dst.y = (paneH - dst.h) / 2;
