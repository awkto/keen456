+#if defined(C_SDL2) && defined(__ANDROID__)
+/* Implemented in the vendored SDL2 (vs/sdl2/src/video/SDL_video.c): size the
+   window framebuffer to the DOS content and GPU-scale it to the full display. */
+extern "C" void SDL_DBX_SetContentSize(int w, int h);
+extern "C" void SDL_DBX_SetContentAspect(double aspect);
+extern "C" void SDL_DBX_InvalidateWindowSurface(SDL_Window *window);
+
+/* Present pacing telemetry, written to last-run.log every ~5s of animation.
+   interval = wall time between presents. Smooth play is this sitting at the
+   display period (16.7ms on 60Hz) with a tight min/max; judder is a wide
+   spread. inside = time spent in the present call itself (texture upload +
+   GPU blit + the vsync wait now that presents are SDL_RENDERER_PRESENTVSYNC).
+   These are the numbers to ask a stuttering device for. */
+#include <unistd.h>
+#include <sys/resource.h>
+static struct {
+    double last = 0.0, iv_sum = 0.0, iv_min = 1e9, iv_max = 0.0;
+    double in_sum = 0.0, in_max = 0.0;
+    unsigned n = 0;
+} dbx_present_stats;
+
+static inline double dbx_now_ms(void) {
+    return (double)SDL_GetPerformanceCounter() * 1000.0 / (double)SDL_GetPerformanceFrequency();
+}
+
+static void dbx_present_account(double t0, double t1) {
+    auto &s = dbx_present_stats;
+    if (s.last > 0.0) {
+        double iv = t0 - s.last;
+        s.iv_sum += iv;
+        if (iv < s.iv_min) s.iv_min = iv;
+        if (iv > s.iv_max) s.iv_max = iv;
+        double in = t1 - t0;
+        s.in_sum += in;
+        if (in > s.in_max) s.in_max = in;
+        s.n++;
+    }
+    s.last = t0;
+    if (s.n >= 300) {
+        LOG_MSG("android present: %u frames, interval avg=%.1f min=%.1f max=%.1f ms, inside avg=%.1f max=%.1f ms",
+                s.n, s.iv_sum / s.n, s.iv_min, s.iv_max, s.in_sum / s.n, s.in_max);
+        s.iv_sum = s.in_sum = s.iv_max = s.in_max = 0.0;
+        s.iv_min = 1e9;
+        s.n = 0;
+    }
+}
+
+static int DBX_TimedUpdateWindowSurface(SDL_Window *win) {
+    double t0 = dbx_now_ms();
+    int r = SDL_UpdateWindowSurface(win);
+    dbx_present_account(t0, dbx_now_ms());
+    return r;
+}
+
+static int DBX_TimedUpdateWindowSurfaceRects(SDL_Window *win, const SDL_Rect *rects, int numrects) {
+    double t0 = dbx_now_ms();
+    int r = SDL_UpdateWindowSurfaceRects(win, rects, numrects);
+    dbx_present_account(t0, dbx_now_ms());
+    return r;
+}
+
+/* Every present in the rest of this file goes through the timed wrappers. */
+#define SDL_UpdateWindowSurface(w) DBX_TimedUpdateWindowSurface(w)
+#define SDL_UpdateWindowSurfaceRects(w, r, n) DBX_TimedUpdateWindowSurfaceRects(w, r, n)
+#endif
+
