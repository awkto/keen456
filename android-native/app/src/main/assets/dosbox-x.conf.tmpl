# Commander Keen 4/5/6 for Android — DOSBox-X config, regenerated by the
# launcher on every start (GameSetup.kt). Edit this template in the repo, not
# the generated file.
#
# Machine/cycles/sound are kept in parity with native/appdir/dosbox-x.conf.tmpl
# (the Linux build) so a save from one plays on the other. What differs, and why:
#
#   output=surface   The Android build is --disable-opengl (device GL is GLES and
#                    our glshader set is desktop GLSL), so there is no `opengl`
#                    output and no `glshader` line. The DOS framebuffer is scaled
#                    to the display on the GPU by the vendored SDL2 instead
#                    (native/patches/0005 + 0006).
#   showmenu=false   No room for DOSBox-X's menu bar on a phone; the on-screen
#                    controls replace it.
#   mapperfile       The desktop mapper minus its plain-F fullscreen bind
#                    (build-assets.sh strips it — the soft keyboard types into
#                    the game, and an 'f' in a save name must not toggle
#                    fullscreen). Kept for what touch CAN produce: speedlock on
#                    plain Tab (the FF button) and save/load state on Ctrl+. /
#                    Ctrl+\ (the 💾 popup), same combos as desktop.

[sdl]
autolock=false
fullscreen=false
showmenu=false
output=surface
mapperfile=${DATA_DIR}/mapper-keen456.map

[render]
# Forced to false on Android by patch 0004 regardless — the CPU post-render
# aspect scaler must never run. The GPU does the aspect fit instead, using the
# intended 4:3 display ratio DOSBox-X reports (sdl.srcAspect), not the raw
# pixel dimensions.
aspect=false

# No software scaler. The CRT look is drawn by the app's FilterOverlayView
# (Settings ▸ Screen filter), not baked into the frame — a CPU 2x scale makes
# the GPU step a downscale, where Smooth/Crisp look identical and scanlines
# average out to nothing. With the raw frame the GPU upscale is where the
# pixels setting bites (SDL_RENDER_SCALE_QUALITY, Settings ▸ Pixels).
scaler=none

# No [vsync] section, deliberately. v1.0.2/3 pinned the emulated vertical timer
# to 60Hz here — zeliard's fix, and right for zeliard, which generates 70
# frames/s. Keen does not: its loop is PIT-timed (70Hz tics, two per frame), so
# it emits 35fps at any CPU speed, and at the native ~70.09Hz VGA rate those
# frames are exactly two vblanks apart. Pinned to 60 the same frames latch 1-2-2
# vblanks apart (measured: 27% / 69%) — a 16.7/33.3ms stutter built in before
# the display is even involved. native/bench-cadence.sh measures this.
#
# Left at 70 nothing floods the display either: the surface output presents
# only frames whose content changed (~35/s), each at the next host vsync
# (patch 0006), so the panel's own rate sets the cadence — 25/33ms at 120Hz,
# and at 60Hz the same 16.7/33.3ms the web build shows. KeenActivity asks for
# the panel's fastest mode for that reason.

[log]
# Written unbuffered, so it survives a crash or a kill. This is the file to ask
# for when diagnosing a device: Android/data/com.awkto.keen456.dx/files/last-run.log
logfile=${DATA_DIR}/last-run.log

[dosbox]
quit warning=false
machine=svga_s3
memsize=16
captures=${DATA_DIR}/capture
saveremark=false
# forceloadstate is deliberately left at its default (false). Setting it true
# disables all four of DOSBox-X's save-state guards (emulator version, running
# program, memory size, machine type), so a state that doesn't match this build
# is deserialized anyway instead of being refused, and a truncated state then
# crashes the emulator inside the loader. Never re-enable it.

[cpu]
core=auto
cputype=auto
cycles=auto
cycleup=10
cycledown=20
stop turbo on key=false

[mixer]
nosound=false
rate=44100
blocksize=1024
prebuffer=20

[sblaster]
sbtype=sb16
sbbase=220
irq=7
dma=1
hdma=5
sbmixer=true
oplmode=auto
oplemu=default
oplrate=44100

[speaker]
pcspeaker=true
pcrate=44100

[dos]
xms=true
ems=true
umb=true
keyboardlayout=auto

[autoexec]
@echo off
mount c "${GAME_DIR}"
c:
${RUNCMD}
exit
