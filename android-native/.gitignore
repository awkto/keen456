# Gradle / IDE
build/
.gradle/
local.properties
*.iml
.idea/

# Native build inputs and outputs — all regenerated by native/build-android.sh
# from the pinned DOSBox-X tag, so none of it is source.
native/dosbox-x/
native/build/
native/build-autogen.log
app/src/main/jniLibs/

# Generated from games/keen4.jsdos + native/appdir/ by build-assets.sh
app/src/main/assets/game/
app/src/main/assets/jsdos-meta/
app/src/main/assets/mapper-keen456.map

# Copied verbatim out of the pinned DOSBox-X tree (vs/sdl2/android-project) by
# native/build-android.sh, so the Java and native halves of SDL always match.
# Globbed per-file (not the directory) so KeenKeyboard.java — our one
# addition to the package, which the copy step never touches — can be
# re-included below; git cannot re-include a file inside an ignored directory.
app/src/main/java/org/libsdl/app/*
!app/src/main/java/org/libsdl/app/KeenKeyboard.java
